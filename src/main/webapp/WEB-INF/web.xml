<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>E-Voting Platform</display-name>
    <description>Secure web-based e-voting system</description>

    <!-- Welcome File -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Session Timeout (30 minutes) -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
    </session-config>

    <!-- ======== Filters ======== -->

    <!-- Model Initialization Listener -->
    <listener>
        <listener-class>com.evoting.listener.ModelInitListener</listener-class>
    </listener>

    <!-- CSRF Protection Filter -->
    <filter>
        <filter-name>CSRFFilter</filter-name>
        <filter-class>com.evoting.filter.CSRFFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CSRFFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Voter Authentication Filter -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.evoting.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/voter/*</url-pattern>
    </filter-mapping>

    <!-- Admin Authentication Filter -->
    <filter>
        <filter-name>AdminAuthFilter</filter-name>
        <filter-class>com.evoting.filter.AdminAuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AdminAuthFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <!-- Face Verification Filter (guards ballot access) -->
    <filter>
        <filter-name>FaceVerifiedFilter</filter-name>
        <filter-class>com.evoting.filter.FaceVerifiedFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>FaceVerifiedFilter</filter-name>
        <url-pattern>/voter/vote</url-pattern>
    </filter-mapping>

    <!-- ======== Servlets ======== -->

    <!-- Public Servlets -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.evoting.servlet.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>OTPServlet</servlet-name>
        <servlet-class>com.evoting.servlet.OTPServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>OTPServlet</servlet-name>
        <url-pattern>/otp</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.evoting.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.evoting.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- Voter Servlets -->
    <servlet>
        <servlet-name>VoteServlet</servlet-name>
        <servlet-class>com.evoting.servlet.VoteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VoteServlet</servlet-name>
        <url-pattern>/voter/vote</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ResultServlet</servlet-name>
        <servlet-class>com.evoting.servlet.ResultServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResultServlet</servlet-name>
        <url-pattern>/results</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>VerifyReceiptServlet</servlet-name>
        <servlet-class>com.evoting.servlet.VerifyReceiptServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VerifyReceiptServlet</servlet-name>
        <url-pattern>/verify-receipt</url-pattern>
    </servlet-mapping>

    <!-- Face Capture/Verify Servlets -->
    <servlet>
        <servlet-name>FaceCaptureServlet</servlet-name>
        <servlet-class>com.evoting.servlet.FaceCaptureServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FaceCaptureServlet</servlet-name>
        <url-pattern>/face/capture</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FaceVerifyServlet</servlet-name>
        <servlet-class>com.evoting.servlet.FaceVerifyServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FaceVerifyServlet</servlet-name>
        <url-pattern>/face/verify</url-pattern>
    </servlet-mapping>

    <!-- Admin Servlets -->
    <servlet>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <servlet-class>com.evoting.servlet.AdminDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <url-pattern>/admin/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminElectionServlet</servlet-name>
        <servlet-class>com.evoting.servlet.AdminElectionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminElectionServlet</servlet-name>
        <url-pattern>/admin/elections</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminCandidateServlet</servlet-name>
        <servlet-class>com.evoting.servlet.AdminCandidateServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminCandidateServlet</servlet-name>
        <url-pattern>/admin/candidates</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminVoterApprovalServlet</servlet-name>
        <servlet-class>com.evoting.servlet.AdminVoterApprovalServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminVoterApprovalServlet</servlet-name>
        <url-pattern>/admin/voters</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminResultServlet</servlet-name>
        <servlet-class>com.evoting.servlet.AdminResultServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminResultServlet</servlet-name>
        <url-pattern>/admin/results</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ExportResultServlet</servlet-name>
        <servlet-class>com.evoting.servlet.ExportResultServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ExportResultServlet</servlet-name>
        <url-pattern>/admin/export</url-pattern>
    </servlet-mapping>

    <!-- Error Pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
</web-app>
